# ANAM Gallery Environment Variables
# Copy this file to .env.local and fill in your actual values

# Airtable Integration (required for CMS functionality)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Webhook Security (for ISR revalidation)
REVALIDATE_SECRET=your_secure_random_webhook_key

# Optional: Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_DSN=your_sentry_dsn_here

# Optional: Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Security: Debug Routes (NEVER enable in production)
# ENABLE_DEBUG_ROUTES=false

# Performance Monitoring
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# BMAD Method Configuration
NEXT_PUBLIC_BMAD_OPTIMIZATION_LEVEL=aggressive
NEXT_PUBLIC_CULTURAL_CONTEXT=eternal